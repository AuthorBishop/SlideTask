    "@types/react": "~19.2.14",
    "babel-preset-expo": "~56.0.0",
    "eslint-plugin-expo": "^1.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~56.0.0",
    "oxlint": "^1.60.0",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "react-test-renderer": "19.2.3",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.3"
  },
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "overrides": {
      "expo-audio": "^56.0.0",
      "expo-video": "^56.0.0",
      "metro-core": "0.84.4",
      "@expo/dom-webview": "^56.0.5"
    }
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|@rn-primitives/.*|lucide-react-native|react-native-gesture-handler|react-native-reanimated|react-native-safe-area-context|react-native-screens|react-native-css-interop|miaoda-expo-devkit)"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "lucide-react-native": "<rootDir>/__mocks__/lucide-react-native.js",
      "lucide-react-native/dist/.*": "<rootDir>/__mocks__/lucide-react-native.js"
    },
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts"
    ]
  }
